# =============================================================================
# SCI INFINITY (FODOL) frontend — Environment configuration
# =============================================================================
# This repository is a static-only frontend. All backend/server configuration
# (port, origins, grant/session/watermark keys, storage root, rate limits,
# abuse detection, external tools) lives in the FODOL server repository.
# =============================================================================
# Copy to `.env.local` to override values locally. NEVER commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# FRONTEND (Vite — compiled into the client bundle and PUBLIC)
# -----------------------------------------------------------------------------
# Base URL of the protected content API. Leave EMPTY when the API is served
# from the same origin (recommended): deploy it behind a reverse proxy at
# /api so cookies stay first-party and no CORS relaxation is needed.
# Read only in `src/lib/contentApi.ts`.
VITE_FODOL_API_BASE=
