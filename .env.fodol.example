# =============================================================================
# FODOL / SCI INFINITY — Environment configuration
# =============================================================================
# Copy to `.env.local` (frontend) and to the server's environment.
# NEVER commit real secrets. Generate each key independently.
# =============================================================================

# -----------------------------------------------------------------------------
# FRONTEND (Vite — these are compiled into the client bundle and are PUBLIC)
# -----------------------------------------------------------------------------
# Base URL of the protected content API. Leave EMPTY when the API is served
# from the same origin (recommended): deploy it behind a reverse proxy at
# /api so cookies stay first-party and no CORS relaxation is needed.
VITE_FODOL_API_BASE=

# Safe staging default: keep public forms in mock mode until privacy approval.
VITE_DB_MODE=mock
VITE_ENABLE_LIVE_FORMS=false


# -----------------------------------------------------------------------------
# SERVER — RUNTIME
# -----------------------------------------------------------------------------
NODE_ENV=production
FODOL_HOST=0.0.0.0
FODOL_PORT=8787

# Set to true ONLY when running behind a trusted reverse proxy that
# overwrites X-Forwarded-For. If true on a directly-exposed server, a client
# can spoof its IP and evade rate limiting.
FODOL_TRUST_PROXY=false

# Comma-separated exact origins permitted to call the API.
# Never use "*" in production (the server refuses to start if you do).
FODOL_ALLOWED_ORIGINS=https://your-domain.example


# -----------------------------------------------------------------------------
# SERVER — SECRETS  (REQUIRED; the server refuses to boot without them)
# -----------------------------------------------------------------------------
# Generate each one separately:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Treat all four as production credentials. Rotating them invalidates every
# outstanding session, grant, and watermark placement.

# Signs short-lived page access grants (60s default).
FODOL_GRANT_SIGNING_KEY=

# Reserved for session cookie signing.
FODOL_SESSION_SIGNING_KEY=

# Derives watermark placement and reader codes. NEVER expose this.
# Rotating it changes every future watermark layout (existing copies keep
# their original marks and remain traceable via the watermark log).
FODOL_WATERMARK_KEY=

# Hashes client IPs for rate limiting without storing raw addresses.
FODOL_IP_HASH_KEY=

# Bearer token for /api/admin/**. Minimum 24 characters.
FODOL_ADMIN_TOKEN=


# -----------------------------------------------------------------------------
# SERVER — PRIVATE STORAGE
# -----------------------------------------------------------------------------
# Absolute path to private storage. MUST be outside any directory the web
# server publishes; the server verifies this and refuses to start otherwise.
FODOL_STORAGE_ROOT=/var/lib/fodol/private-storage


# -----------------------------------------------------------------------------
# SERVER — EXTERNAL TOOLS (required for ingest)
# -----------------------------------------------------------------------------
# MuPDF (mutool) — used to rasterise PDF pages.
#   Windows : download from mupdf.com, set to ...\mutool.exe
#   Debian  : apt-get install mupdf-tools   -> /usr/bin/mutool
#   macOS   : brew install mupdf-tools      -> /opt/homebrew/bin/mutool
FODOL_MUTOOL_PATH=

# ImageMagick — composites the watermark and encodes WebP/JPEG.
# Must be genuine ImageMagick. Both `magick` (v7) and `convert` (v6) are
# accepted, but the binary is version-probed and rejected if it is not
# ImageMagick. (On Windows, C:\Windows\system32\convert.exe is the
# filesystem utility, NOT ImageMagick, and is never used.)
FODOL_IMAGE_TOOL=


# -----------------------------------------------------------------------------
# SERVER — ACCESS CONTROL TUNING
# -----------------------------------------------------------------------------
# Grant lifetime. Shorter = safer against link sharing, more re-fetch chatter.
FODOL_GRANT_TTL_SECONDS=60
FODOL_GRANT_SINGLE_USE=true
FODOL_GRANT_MAX_PAGES=1

# Reading session timeouts.
FODOL_SESSION_IDLE_SECONDS=1800
FODOL_SESSION_ABSOLUTE_SECONDS=43200
FODOL_SESSION_MAX_PER_IP=6


# -----------------------------------------------------------------------------
# SERVER — RATE LIMITS (per the brief: configurable thresholds)
# -----------------------------------------------------------------------------
FODOL_RL_GRANT_PER_MIN=30
FODOL_RL_GRANT_PER_HOUR=600
FODOL_RL_PAGE_PER_MIN=90
FODOL_RL_PAGE_PER_HOUR=1200
FODOL_RL_ADMIN_PER_MIN=20
FODOL_MAX_CONCURRENT_PAGES=4


# -----------------------------------------------------------------------------
# SERVER — ABUSE DETECTION
# -----------------------------------------------------------------------------
FODOL_ABUSE_SEQ_WINDOW=20
FODOL_ABUSE_SEQ_THRESHOLD=12
FODOL_ABUSE_THROTTLE_SCORE=50
FODOL_ABUSE_SUSPEND_SCORE=100
FODOL_ABUSE_SUSPENSION_SECONDS=900
FODOL_ABUSE_DECAY_PER_MINUTE=10


# -----------------------------------------------------------------------------
# SERVER — IMAGE RENDERING
# -----------------------------------------------------------------------------
FODOL_IMAGE_FORMAT=webp
FODOL_MAX_PIXELS_PER_PAGE=40000000
FODOL_MAX_DIMENSION=4000


# -----------------------------------------------------------------------------
# SERVER — UPLOAD VALIDATION
# -----------------------------------------------------------------------------
FODOL_UPLOAD_MAX_BYTES=262144000
FODOL_UPLOAD_MAX_PAGES=500
FODOL_UPLOAD_REJECT_ACTIVE_CONTENT=true
